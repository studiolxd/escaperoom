{
  "name": "escaperoom",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:worker": "pnpm --filter @escaperoom/worker dev",
    "dev:editor-sync": "pnpm --filter @escaperoom/web editor-sync",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bash scripts/verify.sh",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "dev:env": "bash scripts/dev-env.sh",
    "pack:build": "pnpm --filter @escaperoom/game-runtime pack:build",
    "db:migrate": "pnpm --filter @escaperoom/shared db:migrate",
    "db:seed": "pnpm --filter @escaperoom/shared db:seed",
    "db:reset": "pnpm --filter @escaperoom/shared db:reset",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:restore": "bash scripts/restore-postgres.sh"
  },
  "devDependencies": {
    "@escaperoom/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}

{
  "name": "@escaperoom/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Procesos de cola del backend: consume la cola de analítica de Redis y escribe en analyticsEvent vía Prisma (specs/16, 14 §8), el job repetitivo de caducidad de claves (specs/02 §4.3) y los envíos de invitación por email (specs/02 §4.4).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@escaperoom/kit": "workspace:*",
    "@escaperoom/shared": "workspace:*",
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@escaperoom/config": "workspace:*",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

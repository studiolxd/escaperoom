# Worker de analítica (ticket 0.7). El worker carga packages/shared/.env
# (lo escribe `pnpm dev:env`) y, si existe, este fichero. Requiere REDIS_URL.
REDIS_URL=redis://localhost:56380

# Envíos de invitación (ticket 5.6, ADR-020): Nodemailer (SMTP) por defecto, Resend opcional.
# Sin SMTP_HOST fuera de producción se usa el jsonTransport de Nodemailer: no sale ningún email.
# En local, Mailpit/MailHog: SMTP_HOST=localhost SMTP_PORT=1025.
APP_URL=http://localhost:3000
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=EscapeRoom Creator
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Firma de los enlaces de confirmación (por defecto APP_SECRET; en desarrollo, uno fijo).
CONFIRMATION_TOKEN_SECRET=

# Observabilidad (ticket 6.4, docs/specs/24 §6): Sentry. Sin SENTRY_DSN queda
# deshabilitado (@escaperoom/kit/observability/sentry-node) — no hace falta
# ninguna cuenta real para que el código funcione.
SENTRY_DSN=

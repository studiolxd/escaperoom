# Worker de analítica (ticket 0.7). El worker carga packages/shared/.env
# (lo escribe `pnpm dev:env`) y, si existe, este fichero. Requiere REDIS_URL.
# Con requirepass (E-13) la URL lleva la contraseña de dev de
# infra/docker-compose.dev.yml (REDIS_PASSWORD, por defecto "redis_dev_only").
REDIS_URL=redis://:redis_dev_only@localhost:56380

# Pool `pg` del adaptador de Prisma 7 (`createPrismaClient`, packages/shared/src/db).
# El worker procesa colas de BullMQ mayormente en serie (poco paralelismo real
# por cola) y comparte el Postgres/PgBouncer con web, colyseus-server y
# editor-sync: un pool pequeño le basta y deja más presupuesto de conexiones
# a los otros tres contra el mismo PgBouncer (infra/README.md).
DB_POOL_MAX=4

# Envíos de invitación (ticket 5.6, ADR-020): Nodemailer (SMTP) por defecto, Resend opcional.
# Sin SMTP_HOST fuera de producción se usa el jsonTransport de Nodemailer: no sale ningún email.
# En local, Mailpit/MailHog: SMTP_HOST=localhost SMTP_PORT=1025.
APP_URL=http://localhost:3000
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=EscapeRoom Creator
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Firma de los enlaces de confirmación (por defecto APP_SECRET; en desarrollo, uno fijo).
CONFIRMATION_TOKEN_SECRET=

# Observabilidad (ticket 6.4, docs/specs/24 §6): Sentry. Sin SENTRY_DSN queda
# deshabilitado (@escaperoom/kit/observability/sentry-node) — no hace falta
# ninguna cuenta real para que el código funcione.
SENTRY_DSN=

# /healthz (E-9, docs/reference/alertas-uptime-kuma.md). Sin definir, no se
# arranca el servidor de salud.
WORKER_HEALTH_PORT=

# Configuración por cola (E-23, resto; docs/specs/24 §6 tiene la tabla con
# recomendación de ajuste en producción). Todas opcionales: sin definir, cada
# factoría usa el mismo valor por defecto que tenía antes en código.
# Concurrencia (jobs en paralelo por proceso):
WORKER_ANALYTICS_CONCURRENCY=
WORKER_ACCESS_KEY_CARDS_CONCURRENCY=
WORKER_INVITATION_EMAIL_CONCURRENCY=
WORKER_PURCHASE_CONFIRMATION_EMAIL_CONCURRENCY=
# Intervalo del scheduler en milisegundos:
WORKER_ACCESS_KEY_EXPIRY_EVERY_MS=
WORKER_ACCESS_KEY_EMAIL_PURGE_EVERY_MS=
WORKER_IP_UA_PURGE_EVERY_MS=
WORKER_PURCHASE_CONFIRMATION_OUTBOX_EVERY_MS=
WORKER_CREATOR_PAYOUTS_EVERY_MS=
WORKER_STRIPE_WEBHOOK_PURGE_EVERY_MS=
WORKER_MCP_OAUTH_PURGE_EVERY_MS=
# Patrón cron (UTC):
WORKER_ANALYTICS_PARTITIONS_CRON=
WORKER_MODERATION_SAMPLING_CRON=

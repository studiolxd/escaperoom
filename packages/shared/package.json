{
  "name": "@escaperoom/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contrato y lógica compartidos: esquemas Zod, servicios de dominio y acceso a datos (Prisma).",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./engine": "./src/engine/index.ts",
    "./templates": "./src/templates/index.ts",
    "./validator": "./src/validator/index.ts",
    "./hints": "./src/hints/index.ts",
    "./chat": "./src/chat/index.ts",
    "./session": "./src/session/index.ts",
    "./services": "./src/services/index.ts",
    "./join-token": "./src/services/join-token.ts",
    "./event-progress": "./src/services/event-progress.ts",
    "./event-runtime": "./src/services/event-runtime.ts",
    "./event-runtime-prisma": "./src/services/event-runtime-prisma-store.ts",
    "./mail": "./src/mail/index.ts",
    "./access-key-cards-queue": "./src/services/access-key-cards-queue.ts",
    "./analytics": "./src/analytics/index.ts",
    "./audio": "./src/audio/index.ts",
    "./db": "./src/db/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@escaperoom/config": "workspace:*",
    "@escaperoom/env": "workspace:*",
    "@escaperoom/kit": "workspace:*",
    "@prisma/client": "6.19.3",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "stripe": "^22.6.2",
    "yjs": "^13.6.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.11.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.1"
  }
}

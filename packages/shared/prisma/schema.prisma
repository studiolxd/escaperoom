generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model accessKey {
  code                String          @id
  eventId             String          @db.Uuid
  sessionId           String?         @db.Uuid
  groupId             String?         @db.Uuid
  email               String?         @db.Citext
  keyType             accessKeyType
  status              accessKeyStatus @default(generated)
  singleUse           Boolean         @default(true)
  requireConfirmation Boolean         @default(false)
  regeneratedFrom     String?
  confirmedAt         DateTime?       @db.Timestamptz(6)
  activatedAt         DateTime?       @db.Timestamptz(6)
  usedAt              DateTime?       @db.Timestamptz(6)
  expiresAt           DateTime?       @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  event               event           @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group               group?          @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accessKey           accessKey?      @relation("accessKeyToaccessKey", fields: [regeneratedFrom], references: [code], onDelete: NoAction, onUpdate: NoAction)
  other_accessKey     accessKey[]     @relation("accessKeyToaccessKey")
  gameSession         gameSession?    @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progressEvent       progressEvent[]

  @@index([eventId], map: "ixAccessKeyEvent")
  @@index([sessionId], map: "ixAccessKeySession")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @db.Timestamptz(6)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "ixAccountUserId")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model analyticsEvent {
  id            BigInt   @default(autoincrement())
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  eventType     String
  sessionId     String?  @db.Uuid
  playerId      String?
  roomVersionId String?  @db.Uuid
  payload       Json     @default("{}")

  @@id([id, createdAt])
  @@index([sessionId], map: "ixAnalyticsEventSession")
  @@index([eventType, createdAt], map: "ixAnalyticsEventType")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contentReport {
  id                                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId                          String
  roomVersionId                       String              @db.Uuid
  reason                              String
  details                             String?
  severity                            String              @default("normal")
  category                            String              @default("other")
  source                              String              @default("user_report")
  status                              contentReportStatus @default(pending)
  reviewedBy                          String?
  createdAt                           DateTime            @default(now()) @db.Timestamptz(6)
  reviewedAt                          DateTime?           @db.Timestamptz(6)
  user_contentReport_reporterIdTouser user                @relation("contentReport_reporterIdTouser", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_contentReport_reviewedByTouser user?               @relation("contentReport_reviewedByTouser", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomVersion                         roomVersion         @relation(fields: [roomVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  moderationAppeal                    moderationAppeal[]

  @@index([severity, createdAt], map: "ixContentReportSeverity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model creditAccount {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?
  organizationId String?
  balanceCredits BigInt           @default(0)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @db.Timestamptz(6)
  organization   organization?    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           user?            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creditMovement creditMovement[]
}

model creditMovement {
  id            BigInt             @id @default(autoincrement())
  accountId     String             @db.Uuid
  movementType  creditMovementType
  amountCredits BigInt
  balanceAfter  BigInt
  referenceType String?
  referenceId   String?
  metadata      Json               @default("{}")
  createdBy     String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  creditAccount creditAccount      @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          user?              @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accountId, createdAt(sort: Desc)], map: "ixCreditMovementAccount")
}

model event {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId             String
  roomVersionId           String        @db.Uuid
  title                   String
  audience                eventAudience @default(general)
  maxSimultaneousSessions Int           @default(10) @db.SmallInt
  groupingMode            groupingMode  @default(random)
  requireConfirmation     Boolean       @default(false)
  config                  Json          @default("{}")
  expiryRules             Json          @default("[]")
  pricingSnapshot         Json
  playersPurchased        Int
  status                  eventStatus   @default(draft)
  createdAt               DateTime      @default(now()) @db.Timestamptz(6)
  accessKey               accessKey[]
  user                    user          @relation(fields: [organizerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomVersion             roomVersion   @relation(fields: [roomVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gameSession             gameSession[]
  purchase                purchase[]

  @@index([organizerId], map: "ixEventOrganizer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model eventRecording {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String      @db.Uuid
  egressId       String
  storagePath    String?
  consentStatus  String      @default("pending")
  status         String      @default("not_started")
  retentionUntil DateTime?   @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  deletedAt      DateTime?   @db.Timestamptz(6)
  gameSession    gameSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model gameSession {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String           @db.Uuid
  colyseusRoomId String?
  name           String
  status         sessionStatus    @default(pending)
  capacity       Int              @db.SmallInt
  startedAt      DateTime?        @db.Timestamptz(6)
  endedAt        DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  accessKey      accessKey[]
  eventRecording eventRecording[]
  event          event            @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group          group[]
  progressEvent  progressEvent[]

  @@index([eventId], map: "ixGameSessionEvent")
}

model group {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String          @db.Uuid
  name          String
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  accessKey     accessKey[]
  gameSession   gameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progressEvent progressEvent[]

  @@index([sessionId], map: "ixGroupSession")
}

model invitation {
  id             String       @id
  organizationId String
  email          String       @db.Citext
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  inviterId      String
  user           user         @relation(fields: [inviterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "ixInvitationEmail")
  @@index([organizationId], map: "ixInvitationOrganizationId")
}

model member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, userId])
  @@index([organizationId], map: "ixMemberOrganizationId")
  @@index([userId], map: "ixMemberUserId")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model moderationAppeal {
  id                                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId                              String
  roomId                                 String?        @db.Uuid
  contentReportId                        String?        @db.Uuid
  reason                                 String
  status                                 String         @default("pending")
  reviewedBy                             String?
  resolutionNote                         String?
  createdAt                              DateTime       @default(now()) @db.Timestamptz(6)
  reviewedAt                             DateTime?      @db.Timestamptz(6)
  contentReport                          contentReport? @relation(fields: [contentReportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_moderationAppeal_creatorIdTouser  user           @relation("moderationAppeal_creatorIdTouser", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_moderationAppeal_reviewedByTouser user?          @relation("moderationAppeal_reviewedByTouser", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room                                   room?          @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model organization {
  id               String          @id
  name             String
  slug             String          @unique
  logo             String?
  metadata         String?
  stripeCustomerId String?
  dpaSignedAt      DateTime?       @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  creditAccount    creditAccount[]
  invitation       invitation[]
  member           member[]
}

model platformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  user      user?    @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pricingTier {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  minPlayers          Int
  maxPlayers          Int?
  priceCentsPerPlayer Int
  currency            String    @default("EUR") @db.Char(3)
  activeFrom          DateTime  @default(now()) @db.Timestamptz(6)
  activeUntil         DateTime? @db.Timestamptz(6)
  createdBy           String
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  user                user      @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activeFrom, activeUntil], map: "ixPricingTierActive")
}

model progressEvent {
  id            BigInt            @id @default(autoincrement())
  sessionId     String            @db.Uuid
  groupId       String?           @db.Uuid
  playerId      String?
  accessKeyCode String?
  puzzleId      String
  eventKind     progressEventKind
  durationMs    Int?
  hintsUsed     Int               @default(0)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  accessKey     accessKey?        @relation(fields: [accessKeyCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  group         group?            @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          user?             @relation(fields: [playerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gameSession   gameSession       @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([groupId], map: "ixProgressEventGroup")
  @@index([sessionId, createdAt], map: "ixProgressEventSession")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String
  purchaseType          purchaseType
  roomVersionId         String?        @db.Uuid
  eventId               String?        @db.Uuid
  resultingRoomId       String?        @db.Uuid
  amountCents           Int
  currency              String         @default("EUR") @db.Char(3)
  platformFeeCents      Int            @default(0)
  creatorShareCents     Int?
  stripePaymentIntentId String?
  stripeTransferId      String?
  status                purchaseStatus @default(pending)
  playSessionStartedAt  DateTime?      @db.Timestamptz(6)
  playSessionColyseusId String?
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  event                 event?         @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room                  room?          @relation(fields: [resultingRoomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomVersion           roomVersion?   @relation(fields: [roomVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                  user           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "ixPurchaseUser")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  roomId    String   @db.Uuid
  rating    Int      @db.SmallInt
  text      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  room      room     @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      user     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roomId])
  @@index([roomId], map: "ixReviewRoom")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model room {
  id                                                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId                                          String
  title                                             String
  status                                            roomStatus         @default(draft)
  saleIndividual                                    Boolean            @default(true)
  saleEvents                                        Boolean            @default(true)
  priceCents                                        Int?
  currency                                          String             @default("EUR") @db.Char(3)
  licensable                                        Boolean            @default(false)
  licensePriceCents                                 Int?
  forkedFromRoomId                                  String?            @db.Uuid
  forkedFromVersionId                               String?            @db.Uuid
  createdAt                                         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                                         DateTime           @default(now()) @db.Timestamptz(6)
  deletedAt                                         DateTime?          @db.Timestamptz(6)
  moderationAppeal                                  moderationAppeal[]
  purchase                                          purchase[]
  review                                            review[]
  roomVersion_room_forkedFromVersionIdToroomVersion roomVersion?       @relation("room_forkedFromVersionIdToroomVersion", fields: [forkedFromVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkRoomForkedFromVersion")
  user                                              user               @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room                                              room?              @relation("roomToroom", fields: [forkedFromRoomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_room                                        room[]             @relation("roomToroom")
  roomSnapshot                                      roomSnapshot[]
  roomUpdate                                        roomUpdate[]
  roomVersion_roomVersion_roomIdToroom              roomVersion[]      @relation("roomVersion_roomIdToroom")

  @@index([authorId], map: "ixRoomAuthor")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "ixRoomTitleTrgm", type: Gin)
}

model roomSnapshot {
  id                    BigInt   @id @default(autoincrement())
  roomId                String   @db.Uuid
  state                 Bytes
  updatesAppliedThrough BigInt
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  room                  room     @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([roomId, id(sort: Desc)], map: "ixRoomSnapshotRoom")
}

model roomUpdate {
  id         BigInt   @id @default(autoincrement())
  roomId     String   @db.Uuid
  updateData Bytes
  authorId   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       user?    @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room       room     @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([roomId, id], map: "ixRoomUpdateRoom")
}

model roomVersion {
  id                                         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId                                     String          @db.Uuid
  semver                                     String
  package                                    Json
  assetsHash                                 String
  changelog                                  String?
  publishedBy                                String
  publishedAt                                DateTime        @default(now()) @db.Timestamptz(6)
  contentReport                              contentReport[]
  event                                      event[]
  purchase                                   purchase[]
  room_room_forkedFromVersionIdToroomVersion room[]          @relation("room_forkedFromVersionIdToroomVersion")
  user                                       user            @relation(fields: [publishedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room_roomVersion_roomIdToroom              room            @relation("roomVersion_roomIdToroom", fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roomId, semver])
  @@index([package(ops: JsonbPathOps)], map: "ixRoomVersionPackage", type: Gin)
  @@index([roomId, publishedAt(sort: Desc)], map: "ixRoomVersionRoom")
}

model session {
  id                   String   @id
  expiresAt            DateTime @db.Timestamptz(6)
  token                String   @unique
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @db.Timestamptz(6)
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "ixSessionUserId")
}

model stripeWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
}

model user {
  id                                                 String             @id
  name                                               String
  email                                              String             @unique @db.Citext
  emailVerified                                      Boolean            @default(false)
  image                                              String?
  locale                                             String             @default("es")
  stripeAccountId                                    String?
  stripeCustomerId                                   String?
  isAdmin                                            Boolean            @default(false)
  isModerator                                        Boolean            @default(false)
  createdAt                                          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                                          DateTime           @default(now()) @db.Timestamptz(6)
  deletedAt                                          DateTime?          @db.Timestamptz(6)
  account                                            account[]
  contentReport_contentReport_reporterIdTouser       contentReport[]    @relation("contentReport_reporterIdTouser")
  contentReport_contentReport_reviewedByTouser       contentReport[]    @relation("contentReport_reviewedByTouser")
  creditAccount                                      creditAccount[]
  creditMovement                                     creditMovement[]
  event                                              event[]
  invitation                                         invitation[]
  member                                             member[]
  moderationAppeal_moderationAppeal_creatorIdTouser  moderationAppeal[] @relation("moderationAppeal_creatorIdTouser")
  moderationAppeal_moderationAppeal_reviewedByTouser moderationAppeal[] @relation("moderationAppeal_reviewedByTouser")
  platformSetting                                    platformSetting[]
  pricingTier                                        pricingTier[]
  progressEvent                                      progressEvent[]
  purchase                                           purchase[]
  review                                             review[]
  room                                               room[]
  roomUpdate                                         roomUpdate[]
  roomVersion                                        roomVersion[]
  session                                            session[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier], map: "ixVerificationIdentifier")
}

enum accessKeyStatus {
  generated
  sent
  pending_confirmation
  confirmed
  active
  used
  expired
}

enum accessKeyType {
  individual
  rotating
  group
  batch
}

enum contentReportStatus {
  pending
  reviewed
  actioned
  dismissed
}

enum creditMovementType {
  purchase
  consumption
  refund
  adjustment
}

enum eventAudience {
  general
  educational
}

enum eventStatus {
  draft
  active
  closed
}

enum groupingMode {
  specific
  random
  free
}

enum progressEventKind {
  solved
  hint_used
  attempt_failed
}

enum purchaseStatus {
  pending
  succeeded
  refunded
  failed
}

enum purchaseType {
  room
  room_license
  event_credits
  platform_credits
}

enum roomStatus {
  draft
  published
  unlisted
  archived
  removed
}

enum sessionStatus {
  pending
  in_progress
  ended
  aborted
}

# Copia a packages/shared/.env (o exporta las vars) para migrar/sembrar.
# Prisma carga `.env` desde el directorio de trabajo (packages/shared): NO crees
# también `prisma/.env` o Prisma falla por conflicto de variables.
# La app usa el pooler; las migraciones van directas a Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:56433/escaperoom
DIRECT_URL=postgresql://postgres:postgres@localhost:55433/escaperoom

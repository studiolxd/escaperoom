# Copia a packages/shared/.env (o exporta las vars) para migrar/sembrar.
# Prisma carga `.env` desde el directorio de trabajo (packages/shared): NO crees
# también `prisma/.env` o Prisma falla por conflicto de variables.
#
# En desarrollo se va DIRECTO a Postgres (55433). PgBouncer (56433) sigue en el
# compose para probar paridad de pooling, pero tras un `migrate reset` sus
# planes cacheados quedan inválidos (ENUMs recreados); por eso no es el default.
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/escaperoom
DIRECT_URL=postgresql://postgres:postgres@localhost:55433/escaperoom

{
  "name": "@escaperoom/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Presets compartidos del workspace: tsconfig, ESLint, Vitest y locales.",
  "exports": {
    "./typescript/base": "./typescript/base.json",
    "./typescript/library": "./typescript/library.json",
    "./typescript/nextjs": "./typescript/nextjs.json",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/react": "./eslint/react.mjs",
    "./eslint/nextjs": "./eslint/nextjs.mjs",
    "./vitest": "./vitest.config.ts",
    "./locales": "./src/locales.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}

# App
NODE_ENV=development
APP_NAME=EscapeRoom Creator
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Servidor Colyseus (ticket 0.5). Por defecto ws://localhost:2567.
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567
# Playtest del editor (ticket 3.8): URL HTTP interna de Colyseus (por defecto,
# la pública con ws→http) y secreto compartido con colyseus-server. Obligatorio
# en producción; en desarrollo hay uno fijo si se deja vacío.
COLYSEUS_INTERNAL_URL=
PLAYTEST_SECRET=

# WebSocket de edición del editor (ticket 3.3): `pnpm dev:editor-sync`.
NEXT_PUBLIC_EDITOR_SYNC_URL=ws://localhost:2568
EDITOR_SYNC_PORT=2568
# Orígenes permitidos en el handshake (CSV). Por defecto, NEXT_PUBLIC_APP_URL.
EDITOR_SYNC_ALLOWED_ORIGINS=http://localhost:3000

# Base de datos (ticket 0.2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/escaperoom

# Secretos (>=32 chars, `openssl rand -base64 32`)
APP_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Redis / colas
REDIS_URL=redis://localhost:6379
QUEUES_ENABLED=false

# Email (ADR-020: Nodemailer por defecto; Resend opcional)
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=EscapeRoom Creator
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Firma de los enlaces de confirmación de asistencia (ticket 5.6). Por defecto APP_SECRET;
# fuera de producción, un secreto de desarrollo fijo.
CONFIRMATION_TOKEN_SECRET=

# Storage (S3/R2)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Canje de claves (ticket 5.8): secreto compartido con colyseus-server para
# firmar el joinToken de la room `event`. Obligatorio en producción (sin él,
# POST /api/access-keys/redeem responde 503); en desarrollo hay uno fijo.
# También firma el token de observador y autentica la lectura del progreso en
# vivo del panel del organizador (ticket 5.9).
# Caducidad del joinToken en segundos (por defecto 900, máximo 7200).
JOIN_TOKEN_SECRET=
JOIN_TOKEN_TTL_SECONDS=

# Publicación por MCP (ticket 4.5): secreto del enlace con el que el creador confirma
# en /publish-confirm la publicación pedida por el agente. El mismo valor en el MCP por
# stdio. Obligatorio en producción (sin él, la tool `publish` responde «no disponible»);
# en desarrollo hay uno fijo. Caducidad en segundos (por defecto 1800, máximo 86400).
PUBLISH_CONFIRM_SECRET=
PUBLISH_CONFIRM_TTL_SECONDS=

# Chat del creador en la web (ticket 4.6, /[locale]/creator/chat), sobre el Vercel AI SDK.
# CREATOR_CHAT_PROVIDER elige el proveedor del modelo: anthropic (por defecto), openai o
# google. Sin la clave del proveedor elegido (ANTHROPIC_API_KEY, OPENAI_API_KEY o
# GOOGLE_GENERATIVE_AI_API_KEY) la página indica que el chat no está configurado. Modelo por
# defecto según el proveedor: claude-sonnet-5 (anthropic), gpt-5.1 (openai) o gemini-3-pro
# (google); CREATOR_CHAT_MODEL lo sustituye.
# Topes de coste por conversación (vacío = valor por defecto): llamadas al modelo (60),
# tokens de entrada + salida (1500000), tokens de salida por respuesta (16000) y caracteres
# del resultado de una tool que se reenvían al modelo (12000).
# CREATOR_CHAT_MCP_URL: solo si el MCP (/mcp/creator) vive en otro proceso; por defecto el
# chat le entrega las peticiones HTTP en el mismo proceso.
CREATOR_CHAT_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CREATOR_CHAT_MODEL=
CREATOR_CHAT_MAX_TURNS=
CREATOR_CHAT_MAX_TOKENS=
CREATOR_CHAT_MAX_OUTPUT_TOKENS=
CREATOR_CHAT_TOOL_RESULT_MAX_CHARS=
CREATOR_CHAT_MCP_URL=

# Observabilidad (ticket 6.4, docs/specs/24 §6): Sentry. Sin SENTRY_DSN, Sentry
# queda deshabilitado (Sentry.init({enabled: false}) en
# @escaperoom/kit/observability/sentry-nextjs) — la app funciona igual, solo
# sin reportar errores. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN son solo de
# build (subida de source maps con @sentry/webpack-plugin): opcionales, un
# build sin ellos funciona igual, solo sin subir mapas.
SENTRY_DSN=
# DSN del navegador (F-12): normalmente el mismo proyecto que SENTRY_DSN, pero
# expuesto al cliente (`NEXT_PUBLIC_*`); sin ella, `instrumentation-client.ts`
# deja Sentry deshabilitado en el navegador igual que el servidor sin SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Generación de audio por IA (ticket 4.9, specs/15 §1-4): voces narradas y diálogos de
# NPC con ElevenLabs. Sin ELEVENLABS_API_KEY la función no está disponible (los endpoints
# `/api/audio/generate/*` responden 503); no rompe el resto de la app.
# ELEVENLABS_VOICE_ID: voz a usar (por defecto la multilingüe de ElevenLabs; sin selector
# de voz en esta iteración, specs/15 no lo pide).
# ELEVENLABS_MODEL_ID: modelo de síntesis (por defecto eleven_multilingual_v2).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=tXgbXPnsMpKXkuTgvE3h
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Pagos y Stripe Connect (specs/02 §2): marketplace con "separate charges and
# transfers" — la plataforma cobra al jugador y transfiere el 70% al creador
# tras el webhook `checkout.session.completed` (nunca application_fee_amount,
# incompatible con este modelo). STRIPE_SECRET_KEY es la clave secreta del
# entorno de test/producción; STRIPE_WEBHOOK_SECRET la da `stripe listen
# --forward-to <url>/api/stripe/webhook` en local, o el endpoint del Dashboard
# en producción. Sin ellas, el checkout y el reparto no están disponibles.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NODE_ENV=development
APP_NAME=EscapeRoom Creator
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Servidor Colyseus (ticket 0.5). Por defecto ws://localhost:2567.
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567
# Playtest del editor (ticket 3.8): URL HTTP interna de Colyseus (por defecto,
# la pública con ws→http) y secreto compartido con colyseus-server. Obligatorio
# en producción; en desarrollo hay uno fijo si se deja vacío.
COLYSEUS_INTERNAL_URL=
PLAYTEST_SECRET=

# WebSocket de edición del editor (ticket 3.3): `pnpm dev:editor-sync`.
NEXT_PUBLIC_EDITOR_SYNC_URL=ws://localhost:2568
EDITOR_SYNC_PORT=2568
# Orígenes permitidos en el handshake (CSV). Por defecto, NEXT_PUBLIC_APP_URL.
EDITOR_SYNC_ALLOWED_ORIGINS=http://localhost:3000

# Base de datos (ticket 0.2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/escaperoom

# Secretos (>=32 chars, `openssl rand -base64 32`)
APP_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Redis / colas
REDIS_URL=redis://localhost:6379
QUEUES_ENABLED=false

# Email (ADR-020: Nodemailer por defecto; Resend opcional)
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=EscapeRoom Creator
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Firma de los enlaces de confirmación de asistencia (ticket 5.6). Por defecto APP_SECRET;
# fuera de producción, un secreto de desarrollo fijo.
CONFIRMATION_TOKEN_SECRET=

# Storage (S3/R2)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Canje de claves (ticket 5.8): secreto compartido con colyseus-server para
# firmar el joinToken de la room `event`. Obligatorio en producción (sin él,
# POST /api/access-keys/redeem responde 503); en desarrollo hay uno fijo.
# Caducidad del joinToken en segundos (por defecto 900, máximo 7200).
JOIN_TOKEN_SECRET=
JOIN_TOKEN_TTL_SECONDS=

# Publicación por MCP (ticket 4.5): secreto del enlace con el que el creador confirma
# en /publish-confirm la publicación pedida por el agente. El mismo valor en el MCP por
# stdio. Obligatorio en producción (sin él, la tool `publish` responde «no disponible»);
# en desarrollo hay uno fijo. Caducidad en segundos (por defecto 1800, máximo 86400).
PUBLISH_CONFIRM_SECRET=
PUBLISH_CONFIRM_TTL_SECONDS=

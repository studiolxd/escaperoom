{
  "name": "@escaperoom/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "E2E con navegador (Playwright, specs/22 §3): juego, evento y editor contra web + colyseus-server + editor-sync reales; y la prueba de carga de 10 sesiones con clientes de protocolo.",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:smoke": "E2E_SMOKE=1 playwright test --grep @smoke",
    "e2e:install": "playwright install --with-deps chromium",
    "load": "tsx load/ten-sessions.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.2",
    "@escaperoom/colyseus-server": "workspace:*",
    "@escaperoom/config": "workspace:*",
    "@escaperoom/shared": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "eslint": "^10.11.0",
    "pg": "8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}

# Variables que consume @escaperoom/kit. NO son secretos reales: son la
# configuración local para el test de integración (los unitarios no necesitan
# nada de esto). Con `pnpm infra:up` los valores de dev son estos.
#
# REDIS_URL — habilita redis, rate-limit (store Redis) y colas/eventos.
REDIS_URL=redis://localhost:56380
# Prefijo de claves; si falta se deriva de APP_NAME.
REDIS_PREFIX=escaperoom
# Colas BullMQ: sin `true`, `enqueue()` es un no-op y no se abre conexión.
QUEUES_ENABLED=false

# Storage S3/R2. En local apunta a MinIO (infra/docker-compose.dev.yml).
STORAGE_PROVIDER=s3
STORAGE_BUCKET=escaperoom-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

{
  "name": "@escaperoom/game-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime del juego (modos play y edit): loader puro del RoomPackage + escena Phaser isométrica.",
  "exports": {
    ".": "./src/index.ts",
    "./loader": "./src/loader/index.ts",
    "./pack": "./src/pack/index.ts",
    "./world": "./src/world/index.ts",
    "./session": "./src/session/index.ts",
    "./phaser": "./src/phaser/index.ts",
    "./three": "./src/three/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "pack:build": "tsx scripts/build-pack.ts"
  },
  "dependencies": {
    "@escaperoom/nav3d": "workspace:*",
    "@escaperoom/shared": "workspace:*",
    "phaser": "4.2.1",
    "sharp": "^0.35.4",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@escaperoom/config": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/three": "0.186.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

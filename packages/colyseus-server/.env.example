# Medio: LiveKit (ticket 2.2, specs/12). Copia este fichero a
# packages/colyseus-server/.env para activar voz y webcam en desarrollo.
#
# Si falta cualquiera de las tres primeras variables, la GameRoom funciona SIN
# medios (degradación limpia): el cliente muestra "sin medios" y la partida
# sigue por Colyseus.

# Signaling. En dev, el contenedor de infra/docker-compose.dev.yml escucha en 7880.
LIVEKIT_URL=ws://localhost:7880

# Claves de juguete del LiveKit local (coinciden con infra/livekit/livekit.yaml).
# En producción van por entorno del despliegue, nunca en el repo.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Opcionales (defaults entre paréntesis):
# Prefijo de la room de LiveKit derivada del roomId (escape).
# LIVEKIT_ROOM_PREFIX=escape
# TTL del token en segundos (21600 = 6 h, la duración máxima de una sesión).
# LIVEKIT_TOKEN_TTL_SECONDS=21600
# Permiso de vídeo por defecto al firmar el token (true; fila B2C de specs/12 §6).
# Un join puede forzarlo a false para contextos educativos.
# LIVEKIT_ALLOW_VIDEO=true

# Playtest del editor (ticket 3.8): secreto compartido con packages/web
# (ruta interna + firma del link de prueba). Obligatorio en producción; en
# desarrollo hay uno fijo si se deja vacío. Caducidad del link en segundos
# (por defecto 7200, máximo 86400).
PLAYTEST_SECRET=
PLAYTEST_TTL_SECONDS=

# Canje de claves (ticket 5.8): secreto compartido con packages/web para
# verificar el joinToken de la room `event`. Obligatorio en producción (sin él
# la room de evento rechaza todos los joins); en desarrollo hay uno fijo si se
# deja vacío. También verifica el token de observador del panel del organizador
# y la credencial de GET /internal/events/:eventId/progress (ticket 5.9).
JOIN_TOKEN_SECRET=

# Eventos (ticket 5.12): con DATABASE_URL (la misma de packages/shared/.env, que
# main.ts ya carga) la room `event` lee el paquete publicado de cada evento y
# persiste el progreso en Postgres. Sin ella, en desarrollo juega el fixture del
# Rey Aldric sin persistir; en producción la room `event` no se crea.
# DATABASE_URL=

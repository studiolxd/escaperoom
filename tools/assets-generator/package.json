{
  "name": "assets-generator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "tiles:build": "python3 scripts/tiles/tilegen.py build --all",
    "tiles:preview": "node scripts/tiles/preview.mjs",
    "tiles:preview-estetica": "node scripts/tiles/preview-estetica.mjs",
    "objetos": "python3 scripts/empaquetar/empaquetar_objeto.py --todos",
    "pack": "python3 scripts/empaquetar/empaquetar_pack.py",
    "verificar": "python3 scripts/verificar.py",
    "validar": "python3 scripts/comun/validar.py",
    "fichas": "python3 scripts/fichas.py",
    "exportar-3d": "python3 scripts/exportar_3d.py",
    "visor": "vite visor --port 5199 --strictPort",
    "test": "node --test scripts/optimizar_glb.test.mjs scripts/generar_catalogo_3d.test.mjs",
    "catalogo-3d": "node scripts/generar_catalogo_3d.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "sharp": "0.34.5",
    "three": "0.186.1",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=26"
  }
}

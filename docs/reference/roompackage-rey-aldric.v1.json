  "dialogs": [
    { "id": "d-intro", "text": { "es": { "text": "Profecía: «Solo los leales que despierten el fuego, equilibren la mesa y encaminen la luz, liberarán al Rey antes de que la última arena caiga.» Tenéis 60 minutos." } } },
    { "id": "d-cuadro", "text": { "es": { "text": "El retrato del Rey Aurelio, el más grande de los cuatro reinos. Su reloj de sol tiene cuatro torres. El cuadro cruje ligeramente…" } } },
    { "id": "d-brasero", "text": { "es": { "text": "El brasero arde: tres brasas flotan sobre las llamas. Se insinúa un número entre el fuego: el 3." } } },
    { "id": "d-mural", "text": { "es": { "text": "El mural se completa: los campesinos llevan las uvas al barril número 5. Un compartimento se abre tras el azulejo central." } } },
    { "id": "d-ranura", "text": { "es": { "text": "El cáliz encaja perfectamente en la ranura. Un mecanismo antiguo lo sujeta… aunque parece que podría recuperarse si hiciera falta." } } },
    { "id": "d-pergamino", "text": { "es": { "text": "Pergamino: «Los vinos encantados guardan memoria de pares: la uva con la uva, el sol con el sol, la llave con la llave.»" } } },
    { "id": "d-catacumbas", "text": { "es": { "text": "Las catacumbas huelen a incienso y a magia oscura. El relicario aguarda sellado sobre el altar. El canal de agua sagrada está seco." } } },
    { "id": "d-sarcofago", "text": { "es": { "text": "Aquí yace Aldric, el Rey Traicionado. La inscripción reza: «Cuatro reinos me vieron nacer, cinco uvas me vieron caer, tres pares me vieron llorar, ocho vasijas me vieron partir.»" } } },
    { "id": "d-vasijas", "text": { "es": { "text": "Ocho vasijas sagradas custodian las cenizas de los antiguos reyes." } } },
    { "id": "d-aviso", "text": { "es": { "text": "La arena casi ha caído. ¡Diez minutos!" } } }
  ],

  "hints": [
    { "id": "hint-arca-1", "puzzleId": "p-candado-arca", "tier": 1, "text": { "es": { "text": "Los cuatro retratos del fondo, de izquierda a derecha: torres, dragones, brasas, estatuas. Contad lo que muestra cada uno." } }, "cost": 1 },
    { "id": "hint-arca-2", "puzzleId": "p-candado-arca", "tier": 2, "text": { "es": { "text": "4 torres, 7 dragones, 3 brasas, 2 estatuas. Pero el brasero hay que encenderlo primero." } }, "cost": 2 },
    { "id": "hint-sello-1", "puzzleId": "p-sello-final", "tier": 1, "text": { "es": { "text": "El epitafio del sarcófago recuerda los números del castillo." } }, "cost": 1 },
    { "id": "hint-sello-2", "puzzleId": "p-sello-final", "tier": 2, "text": { "es": { "text": "4 reinos, 5 del barril del mural, 3 pares de copas, 8 vasijas." } }, "cost": 2 },
    { "id": "hint-sello-3", "puzzleId": "p-sello-final", "tier": 3, "text": { "es": { "text": "El agua debe fluir por el altar antes de que el sello acepte el código." } }, "cost": 3 }
  ]
